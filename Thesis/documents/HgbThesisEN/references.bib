@inproceedings{PoelmanAkmanLukotsch2012,
	author = {Poelman, Ronald and Akman, Oytun and Lukosch, Stephan and Jonker, Pieter},
	title = {As if being there: mediated reality for crime scene investigation},
	year = {2012},
	isbn = {9781450310864},
	publisher = {Association for Computing Machinery},
	address = {New York, NY, USA},
	url = {https://doi.org/10.1145/2145204.2145394},
	doi = {10.1145/2145204.2145394},
	abstract = {This paper presents a novel mediated reality system designed to support collaboration between crime scene investigators during a first analysis on a crime scene, remotely supported by expert colleagues. Requirements elicited from interviews and interactive sessions with practicing crime scene investigators, provided the design criteria for a head mounted display capable of real-time map-making for spatial collaboration. The resulting system is evaluated in a staged crime scene experiment in which lay investigators collaboratively solve a spatial problem with remote experts. The results show that our novel approach to remote spatial interaction with the physical scene enables investigators to tackle current issues on site in collaboration with experts at a distance.},
	booktitle = {Proceedings of the ACM 2012 Conference on Computer Supported Cooperative Work},
	pages = {1267–1276},
	numpages = {10},
	keywords = {mediated reality, collaborative spatial analysis, augmented reality},
	location = {Seattle, Washington, USA},
	series = {CSCW '12}
}

